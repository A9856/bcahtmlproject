toString() -> The toString() method is used to convert an object into a readable string format for display.

class Student {
    constructor(name, age) {
        this.name = name;
        this.age = age;
    }

    // Overriding the default toString() method
    toString() {
        return `Student [Name: ${this.name}, Age: ${this.age}]`;
    }
}

// Creating an object
const s1 = new Student("Amit", 22);

// Displaying the object (toString is called automatically when converted to a string)
console.log(s1.toString()); // Output: Student [Name: Amit, Age: 22]
console.log("Details: " + s1); // Output: Details: Student [Name: Amit, Age: 22]

