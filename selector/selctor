mix 4 attribute
<html>

<head>
    <style>
        [class*="fo"] {
            background-color: green;
        }

        [class $="a"] {
            background-color: red;
        }

        [class ^="s"] {
            background-color: yellow;
        }

        [class|=black] {
            color: green;
        }
    </style>
</head>

<body>
    <h4 class="fourthheading">this is heading third and *value substring value search</h3>
        <p class="firstpara">this is paragraph..and $ value end </p>
        <p class="secondpara">This is second paragraph..and ^ value start</p>
        <p class="this_header">This is third paragraph..</p>
        <p class="fourthpara">This is second paragraph..and $ value end </p>
        <p class="black-1">This is attribute value paragraph..and | value start</p>
        <p class="black1">This is second paragraph..</p>
</body>

</html>